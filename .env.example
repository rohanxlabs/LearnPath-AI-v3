# =============================================================================
# LearnPath AI v3 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Groq AI API key — used for all LLM calls (fast inference, generous free tier)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-api-key-here

# (Legacy — no longer used; kept for reference only)
# OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# PostgreSQL connection string (Supabase / Neon / any standard Postgres)
# For Supabase: find it in Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://user:pass@host:5432/database?sslmode=require

# ---------------------------------------------------------------------------
# Supabase Authentication (required for login / register / password reset)
# ---------------------------------------------------------------------------
# Find these in your Supabase project → Settings → API

# Project URL  (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe to expose to the browser (also used by the server
# when performing password-based sign-in)
SUPABASE_ANON_KEY=your-anon-public-key-here

# Service-role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# JWT secret — required ONLY for older Supabase projects using HS256 tokens.
# Newer projects use ES256 (asymmetric JWKS) and do NOT need this variable —
# the server fetches the public key automatically from SUPABASE_URL.
# Location: Supabase dashboard → Settings → API → JWT Settings → JWT Secret
# Leave blank for ES256 projects (most projects created after mid-2024).
SUPABASE_JWT_SECRET=

# Vite exposes these two keys to the React frontend (note the VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Express session secret — no longer required (sessions removed; kept for reference only)
# SESSION_SECRET=your-random-session-secret-min-32-chars

# ---------------------------------------------------------------------------
# Recommended (enables key features)
# ---------------------------------------------------------------------------

# Your public frontend URL (used for CORS + OpenRouter HTTP-Referer)
# On Render, set this to your service URL: https://learnpath-ai.onrender.com
FRONTEND_URL=http://localhost:3000

# Server port (defaults to 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Sentry DSN for backend error tracking
# Get yours at: https://sentry.io (free tier available)
SENTRY_DSN=

# Sentry DSN for frontend error tracking (prefixed with VITE_ so Vite exposes it)
VITE_SENTRY_DSN=

# Sentry source-map upload (only needed for production builds)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=learnpath-ai

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# YouTube Data API v3 key — enables embedded videos in topic overviews.
# Without it, topic videos fall back to a YouTube search link instead.
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here

# Resend API key — required for email verification + password reset
# Get yours at: https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=

# From-address for transactional emails (must be a verified Resend domain)
EMAIL_FROM=noreply@yourdomain.com

# Redis / Upstash — enables shared rate-limit store across instances
# Get REST URL + token from: https://console.upstash.com → your database → REST API tab.
#
# REDIS_URL  — the REST URL, e.g.: https://uncommon-toad-177204.upstash.io
#              (a raw rediss:// connection string also works — it is converted automatically)
# REDIS_TOKEN — the token shown on the same page (not the redis password)
#
# ⚠ Render users: paste ONLY the value into each field — do NOT include the
#   key name (REDIS_URL=) or surrounding quotes in the value field.
REDIS_URL=
REDIS_TOKEN=

# Pino log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# PostHog analytics (optional — analytics are disabled when key is not set)
# Get yours at: https://app.posthog.com (free tier available)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
