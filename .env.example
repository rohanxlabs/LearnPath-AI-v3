# =============================================================================
# LearnPath AI v3 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenRouter AI API key (multi-model LLM access)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# PostgreSQL connection string (Neon serverless recommended)
# Get yours at: https://neon.tech
DATABASE_URL=postgresql://user:pass@host:5432/database?sslmode=require

# Express session secret — must be at least 32 random characters
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-random-session-secret-min-32-chars

# ---------------------------------------------------------------------------
# Recommended (enables key features)
# ---------------------------------------------------------------------------

# Your public frontend URL (used for CORS + OpenRouter HTTP-Referer)
# On Render, set this to your service URL: https://learnpath-ai.onrender.com
FRONTEND_URL=http://localhost:3000

# Server port (defaults to 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Sentry DSN for backend error tracking
# Get yours at: https://sentry.io (free tier available)
SENTRY_DSN=

# Sentry DSN for frontend error tracking (prefixed with VITE_ so Vite exposes it)
VITE_SENTRY_DSN=

# Sentry source-map upload (only needed for production builds)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=learnpath-ai

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# YouTube Data API v3 key — enables embedded videos in topic overviews.
# Without it, topic videos fall back to a YouTube search link instead.
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here

# Resend API key — required for email verification + password reset
# Get yours at: https://resend.com (free 3,000 emails/month)
RESEND_API_KEY=

# From-address for transactional emails (must be a verified Resend domain)
EMAIL_FROM=noreply@yourdomain.com

# Redis / Upstash — enables shared rate-limit store across instances
# Get REST URL + token from: https://console.upstash.com
REDIS_URL=
REDIS_TOKEN=

# Pino log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# PostHog analytics (optional — analytics are disabled when key is not set)
# Get yours at: https://app.posthog.com (free tier available)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
